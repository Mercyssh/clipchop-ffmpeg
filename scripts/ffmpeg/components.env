# Clippy's minimal LGPL ffmpeg — pinned versions and the exact component list.
# Sourced by build.sh and parsed by verify.py (simple KEY="value" lines only),
# so this file is the single source of truth for what the build contains.

# ---- pinned sources ----
FFMPEG_VERSION="9.0.2"
FFMPEG_SHA256="8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e"
DAV1D_VERSION="1.5.4"
NVCODEC_VERSION="n12.2.72.0"   # NVIDIA driver 550+ (Windows 551.61+)
AMF_VERSION="v1.5.3"
LIBVPL_VERSION="v2.17.0"
LIBVA_VERSION="2.24.1"
LIBDRM_VERSION="libdrm-2.4.134"

# ---- what Clippy uses (render.py, transcribe.py, exec.rs, ops.rs) ----
PROTOCOLS="file,pipe"
DEMUXERS="mov,matroska,avi,mpegps,mpegts,asf,concat,image2,image_png_pipe,wav,mp3,aac,flac,ogg"
MUXERS="mp4,mov,null,pcm_f32le,pcm_s16le,image2"
DECODERS="wrapped_avframe,h264,hevc,mpeg4,msmpeg4v3,mpeg1video,mpeg2video,vp8,vp9,libdav1d,prores,mjpeg,png,wmv1,wmv2,wmv3,vc1,aac,aac_latm,mp3float,mp3,opus,vorbis,flac,ac3,eac3,alac,wmav1,wmav2,wmapro,pcm_*"
ENCODERS="aac,png,pcm_s16le,pcm_f32le,wrapped_avframe"
PARSERS="h264,hevc,aac,aac_latm,mpegaudio,mpeg4video,mpegvideo,vp8,vp9,av1,ac3,opus,vorbis,flac,png,vc1"
BSFS="h264_mp4toannexb,hevc_mp4toannexb,aac_adtstoasc,extract_extradata,vp9_superframe_split,null"
# Includes the ones ffmpeg inserts by itself (buffer/sink, scale, aresample,
# format, trim for -t, fps for -r, null).
FILTERS="trim,atrim,setpts,asetpts,atempo,volume,alimiter,scale,pad,setsar,drawbox,overlay,split,asplit,concat,fade,afade,xfade,acrossfade,format,aformat,aresample,null,anull,color,fps,buffer,buffersink,abuffer,abuffersink"
INDEVS="lavfi"

# ---- per platform: the H.264 encoders Clippy probes (see src-tauri/src/encoders.rs) ----
ENCODERS_WINDOWS="h264_nvenc,h264_qsv,h264_amf,h264_mf"
ENCODERS_MACOS="h264_videotoolbox"
ENCODERS_LINUX="h264_nvenc,h264_vaapi"
FILTERS_LINUX="hwupload"
